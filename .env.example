# MiniMax Token Plan
MINIMAX_TOKEN_PLAN_TIER=max
MINIMAX_TOKEN_PLAN_KEY2=your_max_token_plan_key

# 可选：estimate 或 whisperx
AUTO_TIKTOK_SUBTITLE_ENGINE=estimate

# 可选：日志等级
AUTO_TIKTOK_LOG_LEVEL=INFO

# Dashboard 安全
# 生产/公网环境必须设置；本机 Docker 默认只映射到 127.0.0.1
AUTO_TIKTOK_DASHBOARD_TOKEN=replace_with_a_long_random_token
AUTO_TIKTOK_DASHBOARD_LOCAL_ONLY=true
AUTO_TIKTOK_DASHBOARD_SESSION_SECONDS=86400
AUTO_TIKTOK_DASHBOARD_SECURE_COOKIES=false
AUTO_TIKTOK_TASK_WORKERS=1

# TikTok 官方 Content Posting API（可选）
TIKTOK_ACCESS_TOKEN=
TIKTOK_POST_MODE=inbox
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Autopilot 可选外部话题源，多个 URL 用逗号分隔
AUTO_TIKTOK_TRENDING_URLS=
